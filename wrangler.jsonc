{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quotecopy",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "headers": {
      "/*": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  }
}
