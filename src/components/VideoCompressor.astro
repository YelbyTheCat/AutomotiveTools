---
// VideoCompressor.astro
---

<div class="compressor-card">
  <h2>Browser Video Compressor</h2>
  
  <div class="input-group">
    <label for="videoInput">Select Video:</label>
    <input type="file" id="videoInput" accept="video/*" />
  </div>

  <div class="controls">
    <label for="scale">Max Height (Scale):</label>
    <select id="scale">
      <option value="original">Original Size</option>
      <option value="720" selected>720p (1280x720)</option>
      <option value="480">480p (854x480)</option>
      <option value="360">360p (640x360)</option>
    </select>

    <label for="crf">Compression Quality (CRF):</label>
    <select id="crf">
      <option value="23">High Quality (Larger size)</option>
      <option value="28" selected>Balanced (Recommended)</option>
      <option value="32">Low Quality (Smaller size)</option>
    </select>
  </div>

  <button id="compressBtn" disabled>Compress Video</button>

  <div id="status" class="status">Loading FFmpeg core...</div>
  <progress id="progressBar" value="0" max="100" style="width: 100%; display: none;"></progress>

  <div id="result" class="result" style="display: none;">
    <h3>Compressed Result:</h3>
    <video id="outputVideo" controls width="100%"></video>
    <br />
    <a id="downloadLink" download="compressed.mp4" class="btn">Download Compressed Video</a>
  </div>
</div>

<script>
  import { FFmpeg } from '@ffmpeg/ffmpeg';
  import { fetchFile, toBlobURL } from '@ffmpeg/util';

  const ffmpeg = new FFmpeg();

  const videoInput = document.getElementById('videoInput') as HTMLInputElement;
  const compressBtn = document.getElementById('compressBtn') as HTMLButtonElement;
  const scaleSelect = document.getElementById('scale') as HTMLSelectElement;
  const crfSelect = document.getElementById('crf') as HTMLSelectElement;
  const statusEl = document.getElementById('status') as HTMLDivElement;
  const progressBar = document.getElementById('progressBar') as HTMLProgressElement;
  const resultDiv = document.getElementById('result') as HTMLDivElement;
  const outputVideo = document.getElementById('outputVideo') as HTMLVideoElement;
  const downloadLink = document.getElementById('downloadLink') as HTMLAnchorElement;

  let selectedFile: File | null = null;

  // Load FFmpeg WebAssembly core from CDN
  async function loadFFmpeg() {
    try {
      const baseURL = 'https://unpkg.com/@ffmpeg/core@0.12.6/dist/esm';
      await ffmpeg.load({
        coreURL: await toBlobURL(`${baseURL}/ffmpeg-core.js`, 'text/javascript'),
        wasmURL: await toBlobURL(`${baseURL}/ffmpeg-core.wasm`, 'application/wasm'),
      });
      statusEl.textContent = 'FFmpeg ready! Select a video file.';
    } catch (err) {
      console.error(err);
      statusEl.textContent = 'Failed to load FFmpeg. Ensure SharedArrayBuffer is enabled via COOP/COEP headers.';
    }
  }

  loadFFmpeg();

  videoInput.addEventListener('change', (e: Event) => {
    const files = (e.target as HTMLInputElement).files;
    if (files && files[0]) {
      selectedFile = files[0];
      compressBtn.disabled = false;
      statusEl.textContent = `Selected: ${selectedFile.name} (${(selectedFile.size / (1024 * 1024)).toFixed(2)} MB)`;
    }
  });

  // Track progress
  ffmpeg.on('progress', ({ progress }) => {
    const percent = Math.min(Math.round(progress * 100), 100);
    progressBar.value = percent;
    statusEl.textContent = `Compressing... ${percent}%`;
  });

  compressBtn.addEventListener('click', async () => {
    if (!selectedFile) return;

    compressBtn.disabled = true;
    videoInput.disabled = true;
    progressBar.style.display = 'block';
    resultDiv.style.display = 'none';

    const inputName = 'input.' + selectedFile.name.split('.').pop();
    const outputName = 'output.mp4';

    // Write file to in-memory Virtual File System (VFS)
    await ffmpeg.writeFile(inputName, await fetchFile(selectedFile));

    // Build FFmpeg command arguments
    const crf = crfSelect.value;
    const scale = scaleSelect.value;

    const ffmpegArgs = ['-i', inputName];

    // Scale down physical dimensions if selected
    if (scale !== 'original') {
      ffmpegArgs.push('-vf', `scale=-2:${scale}:flags=bicubic`);
    }

    // Apply CRF (Constant Rate Factor) and standard H.264 / AAC encoding
    ffmpegArgs.push(
      '-c:v', 'libx264',
      '-crf', crf,
      '-preset', 'fast', // 'ultrafast' or 'superfast' works best for browser JS execution
      '-pix_fmt', 'yuv420p',
      '-c:a', 'aac',
      '-b:a', '128k',
      outputName
    );

    // Execute compression
    await ffmpeg.exec(ffmpegArgs);

    // Read back output from Virtual File System
    const data = await ffmpeg.readFile(outputName);
    const compressedBlob = new Blob([data as Uint8Array], { type: 'video/mp4' });
    const url = URL.createObjectURL(compressedBlob);

    // Show output
    outputVideo.src = url;
    downloadLink.href = url;
    
    const origMB = (selectedFile.size / (1024 * 1024)).toFixed(2);
    const newMB = (compressedBlob.size / (1024 * 1024)).toFixed(2);

    statusEl.textContent = `Done! Original: ${origMB}MB ➔ Compressed: ${newMB}MB`;
    resultDiv.style.display = 'block';
    compressBtn.disabled = false;
    videoInput.disabled = false;

    // Clean up memory
    await ffmpeg.deleteFile(inputName);
    await ffmpeg.deleteFile(outputName);
  });
</script>

<style>
  .compressor-card {
    max-width: 500px;
    margin: 2rem auto;
    padding: 1.5rem;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-family: sans-serif;
  }
  .controls, .input-group {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  button {
    padding: 0.5rem 1rem;
    cursor: pointer;
  }
  .status {
    margin-top: 1rem;
    font-weight: bold;
  }
  .result {
    margin-top: 1rem;
  }
  .btn {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.5rem 1rem;
    background: #0066cc;
    color: white;
    text-decoration: none;
    border-radius: 4px;
  }
</style>
